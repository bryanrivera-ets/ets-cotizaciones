# Copia este archivo como ".env" y llena los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web → Configuración del SDK).
# Estos valores NO son secretos: identifican el proyecto. La seguridad está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
