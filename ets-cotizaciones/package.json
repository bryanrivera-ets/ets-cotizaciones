{
  "name": "ets-cotizaciones",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "pdf:examples": "tsx --tsconfig tsconfig.scripts.json scripts/render-examples.tsx",
    "pdf:compare": "python3 scripts/compare-examples.py",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ets-rules \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-ets",
    "dev:emu": "vite --mode emulators"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "firebase": "^13.3.0",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.10",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.36.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
